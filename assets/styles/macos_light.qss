/* Shuttle macOS Light Theme */
QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #f5f5f7;
}

QFrame#toolbar {
    background-color: #f6f6f6;
    border-bottom: 1px solid #d2d2d7;
    padding: 0;
}

QFrame#status_bar {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 7px;
}

QPushButton {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #c6c6c8;
    border-radius: 6px;
    padding: 5px 12px;
    min-height: 24px;
    font-weight: 500;
}

QPushButton:hover:!disabled {
    background-color: #f2f2f4;
    border-color: #a8a8ad;
}

QPushButton:pressed:!disabled {
    background-color: #e8e8ed;
}

QPushButton:disabled {
    color: #9a9aa0;
    background-color: #f3f3f5;
    border-color: #dedee3;
}

QPushButton#primary_btn {
    background-color: #007aff;
    color: #ffffff;
    border: 1px solid #007aff;
}

QPushButton#primary_btn:hover:!disabled {
    background-color: #0a84ff;
    border-color: #0a84ff;
}

QPushButton#danger_btn {
    background-color: #ff3b30;
    color: #ffffff;
    border-color: #ff3b30;
}

QPushButton#icon_btn {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    border-radius: 6px;
    background-color: transparent;
    border: none;
    font-size: 14px;
}

QPushButton#icon_btn:hover {
    background-color: #e8e8ed;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #c6c6c8;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:on {
    border-color: #007aff;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c6c6c8;
    color: #1d1d1f;
    selection-background-color: #e8f2ff;
    selection-color: #1d1d1f;
    outline: none;
}

QLabel {
    background-color: transparent;
    color: #1d1d1f;
}

QLabel#secondary_label {
    color: #6e6e73;
    font-size: 11px;
}

QLabel#section_header {
    color: #1d1d1f;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 0 4px 0;
}

QLabel#connection_connected {
    color: #248a3d;
    font-weight: 600;
}

QLabel#connection_disconnected {
    color: #d70015;
    font-weight: 600;
}

QCheckBox {
    spacing: 8px;
    color: #1d1d1f;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #b8b8bd;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #007aff;
    border-color: #007aff;
}

QProgressBar {
    background-color: #e8e8ed;
    border: 1px solid #d2d2d7;
    border-radius: 4px;
    height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #007aff;
    border-radius: 3px;
}

QTreeWidget, QListWidget {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 7px;
    outline: none;
    alternate-background-color: #f8f8fa;
}

QTreeWidget::item, QListWidget::item {
    padding: 5px 8px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #f2f2f4;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #6e6e73;
    border: none;
    border-bottom: 1px solid #d2d2d7;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 500;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #c6c6c8;
    border-radius: 6px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #c6c6c8;
    border-radius: 6px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 7px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #007aff;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #d2d2d7;
    margin: 5px 8px;
}

QTabWidget::pane {
    border: none;
    background-color: #f5f5f7;
}

QTabWidget {
    background-color: #f5f5f7;
}

QTabBar {
    background-color: #f5f5f7;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #f5f5f7;
    color: #6e6e73;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #007aff;
    border-bottom-color: #007aff;
    background-color: #f5f5f7;
}

QTabBar::tab:hover:!selected {
    color: #1d1d1f;
    background-color: #ececee;
}

QFrame#transfer_item {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #e5e5ea;
    border-radius: 0;
}

QPushButton#bookmark_btn {
    background-color: #ffffff;
    border-color: #d2d2d7;
    color: #1d1d1f;
    padding: 2px 8px;
    min-height: 22px;
    font-size: 11px;
}

QToolTip {
    background-color: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    padding: 3px 6px;
    border-radius: 5px;
}

/* ============================================================================
   TRANSFER STATUS LABELS
   ============================================================================ */
QLabel#status_pending {
    color: #8e8e93;
    font-size: 11px;
}

QLabel#status_active {
    color: #007aff;
    font-size: 11px;
}

QLabel#status_success {
    color: #248a3d;
    font-size: 11px;
}

QLabel#status_error {
    color: #d70015;
    font-size: 11px;
}

QLabel#secondary_label {
    color: #6e6e73;
    font-size: 11px;
}
