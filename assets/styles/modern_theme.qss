/* FileSling — Modern Dark Theme (iOS-inspired, 2026) */

/* ============================================================================
   BASE
   ============================================================================ */
QWidget {
    background-color: #1c1c1e;
    color: #f5f5f7;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #1c1c1e;
}

/* ============================================================================
   TOOLBAR & STATUS BAR
   ============================================================================ */
QFrame#toolbar {
    background-color: #2c2c2e;
    border-bottom: 1px solid #38383a;
    padding: 0;
}

/* ============================================================================
   BUTTONS
   ============================================================================ */
QPushButton {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 26px;
    font-weight: 500;
}

QPushButton:hover:!disabled {
    background-color: #48484a;
    border-color: #5a5a5c;
}

QPushButton:pressed:!disabled {
    background-color: #545456;
}

QPushButton:disabled {
    color: #636366;
    background-color: #2c2c2e;
    border-color: #38383a;
}

QPushButton#primary_btn {
    background-color: #0a84ff;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#primary_btn:hover:!disabled {
    background-color: #409cff;
}

QPushButton#icon_btn {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0;
    border-radius: 8px;
    background-color: transparent;
    border: none;
    font-size: 15px;
}

QPushButton#icon_btn:hover {
    background-color: #3a3a3c;
}

/* ============================================================================
   INPUTS & COMBO BOXES
   ============================================================================ */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 8px;
    padding: 6px 10px 6px 12px;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0a84ff;
}

QComboBox {
    background-color: #2c2c2e;
    color: #f5f5f7;
    border: 1px solid #48484a;
    border-radius: 8px;
    padding: 4px 10px;
    min-height: 22px;
}

QComboBox:on, QComboBox:focus {
    border-color: #0a84ff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
    padding-right: 4px;
}

QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 10px;
    color: #f5f5f7;
    padding: 4px;
    outline: none;
    selection-background-color: transparent;
    selection-color: #f5f5f7;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 6px;
    min-height: 18px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #3a3a3c;
}

/* ============================================================================
   LABELS
   ============================================================================ */
QLabel {
    background-color: transparent;
    color: #f5f5f7;
}

QLabel#secondary_label {
    color: #98989d;
    font-size: 11px;
}

QLabel#section_header {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 0 4px 0;
}

/* ============================================================================
   CONNECTION STATUS
   ============================================================================ */
QLabel#connection_connected {
    color: #30d158;
    font-weight: 600;
}

QLabel#connection_disconnected {
    color: #ff453a;
    font-weight: 600;
}

QLabel#connection_warning {
    color: #ff9f0a;
    font-weight: 600;
}

QLabel#connection_slow {
    color: #ff6961;
    font-weight: 600;
}

/* ============================================================================
   CHECKBOXES
   ============================================================================ */
QCheckBox {
    spacing: 8px;
    color: #f5f5f7;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1.5px solid #636366;
    background-color: #2c2c2e;
}

QCheckBox::indicator:checked {
    background-color: #0a84ff;
    border-color: #0a84ff;
}

/* ============================================================================
   PROGRESS BARS
   ============================================================================ */
QProgressBar {
    background-color: #2c2c2e;
    border: none;
    border-radius: 5px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0a84ff;
    border-radius: 5px;
}

/* ============================================================================
   FILE EXPLORER / TREE
   ============================================================================ */
QTreeWidget, QListWidget {
    background-color: #1c1c1e;
    border: 1px solid #38383a;
    border-radius: 10px;
    outline: none;
    alternate-background-color: #212123;
}

QTreeWidget::item, QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    margin: 1px 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #2c2c2e;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1c1c1e;
    color: #98989d;
    border: none;
    border-bottom: 1px solid #38383a;
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

/* ============================================================================
   SCROLL BARS
   ============================================================================ */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background-color: #48484a;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #636366;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #48484a;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #636366;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ============================================================================
   MENUS
   ============================================================================ */
QMenu {
    background-color: #2c2c2e;
    border: 1px solid #48484a;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px 8px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #38383a;
    margin: 4px 10px;
}

/* ============================================================================
   TABS
   ============================================================================ */
QTabWidget::pane {
    border: none;
    background-color: #1c1c1e;
}

QTabWidget {
    background-color: #1c1c1e;
}

QTabBar {
    background-color: #1c1c1e;
}

QTabBar::tab {
    background-color: transparent;
    color: #98989d;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 18px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #0a84ff;
    border-bottom-color: #0a84ff;
}

QTabBar::tab:hover:!selected {
    color: #f5f5f7;
}

/* ============================================================================
   TRANSFER QUEUE
   ============================================================================ */
QFrame#transfer_item {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #2c2c2e;
    border-radius: 0;
}

/* ============================================================================
   BOOKMARKS
   ============================================================================ */
QPushButton#bookmark_btn {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    color: #f5f5f7;
    padding: 3px 10px;
    min-height: 24px;
    font-size: 11px;
    border-radius: 6px;
}

QPushButton#bookmark_btn:hover {
    background-color: #3a3a3c;
}

/* ============================================================================
   TOOLTIPS
   ============================================================================ */
QToolTip {
    background-color: #3a3a3c;
    color: #f5f5f7;
    border: none;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 12px;
}

/* ============================================================================
   TRANSFER STATUS LABELS
   ============================================================================ */
QLabel#status_pending {
    color: #98989d;
    font-size: 11px;
}

QLabel#status_active {
    color: #64d2ff;
    font-size: 11px;
}

QLabel#status_success {
    color: #30d158;
    font-size: 11px;
}

QLabel#status_error {
    color: #ff453a;
    font-size: 11px;
}

/* ============================================================================
   SUBTLE / TEXT BUTTONS
   ============================================================================ */
QPushButton#subtle_btn {
    background-color: transparent;
    border: none;
    color: #98989d;
    font-size: 11px;
    padding: 2px 8px;
}

QPushButton#subtle_btn:hover {
    color: #f5f5f7;
}
