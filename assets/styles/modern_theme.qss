/* FileSling macOS Dark Theme */
QWidget {
    background-color: #202124;
    color: #f5f5f7;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QMessageBox {
    background-color: #202124;
}

QFrame#toolbar {
    background-color: #2a2b2f;
    border-bottom: 1px solid #3a3b40;
    padding: 0;
}

QFrame#status_bar {
    background-color: #26272b;
    border: 1px solid #393a3f;
    border-radius: 7px;
}

QPushButton {
    background-color: #2f3034;
    color: #f5f5f7;
    border: 1px solid #4a4b50;
    border-radius: 6px;
    padding: 5px 12px;
    min-height: 24px;
    font-weight: 500;
}

QPushButton:hover:!disabled {
    background-color: #3a3b40;
    border-color: #62636a;
}

QPushButton:pressed:!disabled {
    background-color: #46474d;
}

QPushButton:disabled {
    color: #777a80;
    background-color: #292a2e;
    border-color: #36373c;
}

QPushButton#primary_btn {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
}

QPushButton#primary_btn:hover:!disabled {
    background-color: #2997ff;
    border-color: #2997ff;
}

QPushButton#danger_btn {
    background-color: #ff453a;
    color: #ffffff;
    border-color: #ff453a;
}

QPushButton#icon_btn {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    border-radius: 6px;
    background-color: transparent;
    border: none;
    font-size: 14px;
}

QPushButton#icon_btn:hover {
    background-color: #3a3b40;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: #2b2c30;
    color: #f5f5f7;
    border: 1px solid #48494f;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:on {
    border-color: #0a84ff;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #2b2c30;
    border: 1px solid #48494f;
    color: #f5f5f7;
    selection-background-color: #3a3b40;
    selection-color: #ffffff;
    outline: none;
}

QLabel {
    background-color: transparent;
    color: #f5f5f7;
}

QLabel#secondary_label {
    color: #a1a1a6;
    font-size: 11px;
}

QLabel#section_header {
    color: #f5f5f7;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 0 4px 0;
}

QLabel#connection_connected {
    color: #32d74b;
    font-weight: 600;
}

QLabel#connection_disconnected {
    color: #ff453a;
    font-weight: 600;
}

QLabel#connection_warning {
    color: #ff9f0a;
    font-weight: 600;
}

QLabel#connection_slow {
    color: #ff6961;
    font-weight: 600;
}

QCheckBox {
    spacing: 8px;
    color: #f5f5f7;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #5a5b61;
    background-color: #2b2c30;
}

QCheckBox::indicator:checked {
    background-color: #0a84ff;
    border-color: #0a84ff;
}

QProgressBar {
    background-color: #2b2c30;
    border: 1px solid #3d3e44;
    border-radius: 4px;
    height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0a84ff;
    border-radius: 3px;
}

QTreeWidget, QListWidget {
    background-color: #242529;
    border: 1px solid #3d3e44;
    border-radius: 7px;
    outline: none;
    alternate-background-color: #28292d;
}

QTreeWidget::item, QListWidget::item {
    padding: 5px 8px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #303137;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #242529;
    color: #a1a1a6;
    border: none;
    border-bottom: 1px solid #3d3e44;
    padding: 5px 8px;
    font-size: 11px;
    font-weight: 500;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #5a5b61;
    border-radius: 6px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
}

QScrollBar::handle:horizontal {
    background-color: #5a5b61;
    border-radius: 6px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QMenu {
    background-color: #2b2c30;
    border: 1px solid #48494f;
    border-radius: 7px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #48494f;
    margin: 5px 8px;
}

QTabWidget::pane {
    border: none;
    background-color: #202124;
}

QTabBar::tab {
    background-color: transparent;
    color: #a1a1a6;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #f5f5f7;
    border-bottom-color: #0a84ff;
}

QTabBar::tab:hover:!selected {
    color: #f5f5f7;
}

QFrame#transfer_item {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #34353a;
    border-radius: 0;
}

QPushButton#bookmark_btn {
    background-color: #2b2c30;
    border-color: #48494f;
    color: #f5f5f7;
    padding: 2px 8px;
    min-height: 22px;
    font-size: 11px;
}

QToolTip {
    background-color: #2b2c30;
    color: #f5f5f7;
    border: 1px solid #48494f;
    padding: 3px 6px;
    border-radius: 5px;
}

/* ============================================================================
   TRANSFER STATUS LABELS
   ============================================================================ */
QLabel#status_pending {
    color: #858585;
    font-size: 11px;
}

QLabel#status_active {
    color: #0ea5e9;
    font-size: 11px;
}

QLabel#status_success {
    color: #4ec9b0;
    font-size: 11px;
}

QLabel#status_error {
    color: #f48771;
    font-size: 11px;
}

QLabel#secondary_label {
    color: #858585;
    font-size: 11px;
}

/* Subtle text-style button */
QPushButton#subtle_btn {
    background-color: transparent;
    border: none;
    color: #858585;
    font-size: 11px;
    padding: 2px 8px;
}

QPushButton#subtle_btn:hover {
    color: #f1f5f9;
}
